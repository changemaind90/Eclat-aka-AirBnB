// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String?
  refreshToken String?
  balance      Int     @default(0)

  listings         Listing[]
  bookings         Booking[]
  reviews          Review[]
  sentTxns         Transaction[] @relation("SentTransactions")
  receivedTxns     Transaction[] @relation("ReceivedTransactions")
  paymentsSent     Payment[]     @relation("PaymentFrom")
  paymentsReceived Payment[]     @relation("PaymentTo")
}

model Listing {
  id             Int    @id @default(autoincrement())
  title          String
  description    String
  address        String
  pricePerNight  Int
  numberOfGuests Int

  transactions Transaction[]

  reviews  Review[]
  bookings Booking[]
  payments Payment[]

  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId Int

  @@index([ownerId])
}

model Booking {
  id         Int      @id @default(autoincrement())
  startDate  DateTime
  endDate    DateTime
  totalPrice Int
  status     Status

  reviews Review[]

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int

  @@index([userId])
  @@index([listingId])
}

model Review {
  id      Int    @id @default(autoincrement())
  rating  Int
  comment String

  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId Int

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId Int

  @@index([authorId])
  @@index([listingId])
  @@index([bookingId])
}

model Transaction {
  id        Int    @id @default(autoincrement())
  amount    Int
  paymentId String @unique

  from   User @relation("SentTransactions", fields: [fromId], references: [id], onDelete: Cascade)
  fromId Int

  to   User? @relation("ReceivedTransactions", fields: [toId], references: [id], onDelete: SetNull)
  toId Int?

  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId Int?

  @@index([fromId])
  @@index([toId])
}

model Payment {
  id         Int           @id @default(autoincrement())
  amount     Int
  status     PaymentStatus @default(PENDING)
  yookassaId String?       @unique
  createdAt  DateTime      @default(now())

  from   User @relation("PaymentFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  fromUserId Int

  to   User @relation("PaymentTo", fields: [toUserId], references: [id], onDelete: Cascade)
  toUserId Int

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int

  @@index([fromUserId])
  @@index([toUserId])
  @@index([listingId])
}
